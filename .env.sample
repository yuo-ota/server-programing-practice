# === Service Ports ===
NGINX_PORT=8000

# === Spring Boot ===
# devかprodを指定
SPRING_PROFILES_ACTIVE=dev
SPRING_APP_PORT=8080
SPRING_SSL_KEY_STORE_PASSWORD=${任意の文字列}

# === Postgres ===
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# === JWT ===
JWT_SECRET=${任意の文字列}

# === Timezone ===
TIMEZONE=Asia/Tokyo
